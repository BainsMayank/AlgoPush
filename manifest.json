{
  "manifest_version": 3,
  "name": "AlgoPush",
  "version": "2.0.0",
  "description": "Pushes every Accepted LeetCode, Codeforces, AtCoder and CodeChef solve to GitHub, and keeps streaks and duels going with friends.",
  "key": "",
  "icons": {
    "16": "images/icon16.png",
    "32": "images/icon32.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "tabs",
    "identity"
  ],
  "host_permissions": [
    "*://leetcode.com/*",
    "*://*.leetcode.com/*",
    "*://codeforces.com/*",
    "*://*.codeforces.com/*",
    "*://atcoder.jp/*",
    "*://*.atcoder.jp/*",
    "*://codechef.com/*",
    "*://*.codechef.com/*",
    "*://kenkoooo.com/*",
    "*://api.github.com/*",
    "*://github.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://leetcode.com/*",
        "*://*.leetcode.com/*"
      ],
      "js": [
        "content-scripts/common.js",
        "content-scripts/leetcode.js"
      ]
    },
    {
      "matches": [
        "*://codeforces.com/*",
        "*://*.codeforces.com/*"
      ],
      "js": [
        "content-scripts/common.js",
        "content-scripts/codeforces.js"
      ]
    },
    {
      "matches": [
        "*://atcoder.jp/*",
        "*://*.atcoder.jp/*"
      ],
      "js": [
        "content-scripts/common.js",
        "content-scripts/atcoder.js"
      ]
    },
    {
      "matches": [
        "*://codechef.com/*",
        "*://*.codechef.com/*"
      ],
      "js": [
        "content-scripts/common.js",
        "content-scripts/codechef.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content-scripts/leetcode-inject.js"
      ],
      "matches": [
        "*://leetcode.com/*",
        "*://*.leetcode.com/*"
      ]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "AlgoPush",
    "default_icon": "images/icon128.png"
  },
  "options_page": "options/options.html"
}
